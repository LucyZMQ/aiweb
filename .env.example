# 本地 Docker Compose / 开发环境示例
# cp .env.example .env

DB_PASSWORD=moyu_dev_password

# 至少 32 字节。生产请使用 openssl rand -hex 32
JWT_SECRET=local-dev-secret-change-me-0123456789abcdef0123456789
JWT_TTL=7d
ADMIN_EMAILS=admin@moyu.local
EXPOSE_DEV_CODE=true

CORS_ORIGINS=http://localhost:8088,http://127.0.0.1:8088,http://127.0.0.1:5173
PUBLIC_BASE_URL=http://localhost:8088

# local | cos
STORAGE_PROVIDER=local
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=
COS_CDN_DOMAIN=

# log | smtp
MAIL_MODE=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@moyu.local
MAIL_FROM_NAME="墨屿 MOYU"

GEETEST_ENABLED=false
GEETEST_CAPTCHA_ID=
GEETEST_CAPTCHA_KEY=

DEMO_DATA=true
SPRINGDOC_ENABLED=true
ANALYTICS_TIMEZONE=Asia/Shanghai
ANALYTICS_IP_SALT=local-dev-salt-change-me

# 前端构建（同源部署留空）
VITE_API_BASE_URL=
VITE_BAIDU_TONGJI_ID=
