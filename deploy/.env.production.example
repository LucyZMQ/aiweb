# ============================================================
# MOYU production environment
# 复制为 /opt/moyu/.env，权限 chmod 600，切勿提交到 Git
# ============================================================

# 域名与证书
DOMAIN=blog.example.com
ACME_EMAIL=you@example.com

# 镜像仓库：GitHub Actions 推到 ghcr.io/<owner>/<repo>
IMAGE_PREFIX=ghcr.io/yourname/moyu
IMAGE_TAG=latest

# 数据库
DB_PASSWORD=replace-with-a-long-random-password

# 认证：至少 32 字节，建议 openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32
ADMIN_EMAILS=you@example.com
ANALYTICS_IP_SALT=replace-with-another-random-salt

# 邮件（生产必须 smtp，否则登录验证码只写日志）
MAIL_MODE=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=replace-with-smtp-password
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME="墨屿 MOYU"

# 极验 v4（关闭时留 false 和空值）
GEETEST_ENABLED=true
GEETEST_CAPTCHA_ID=replace-with-geetest-captcha-id
GEETEST_CAPTCHA_KEY=replace-with-geetest-captcha-key

# 对象存储：local 或 cos
STORAGE_PROVIDER=cos
COS_SECRET_ID=replace-with-cos-secret-id
COS_SECRET_KEY=replace-with-cos-secret-key
COS_REGION=ap-guangzhou
COS_BUCKET=moyu-1250000000
COS_CDN_DOMAIN=https://cdn.example.com

# 其他
DEMO_DATA=false
ANALYTICS_TIMEZONE=Asia/Shanghai

# GitHub Actions 部署时使用（服务器本地也需要，用于拉私有镜像）
GHCR_TOKEN=replace-with-github-pat-with-read-packages
